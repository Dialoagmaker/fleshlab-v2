{
  "name": "Performer",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "bio": {
      "type": "string",
      "title": "Bio",
      "format": "textarea"
    },
    "nationality": {
      "type": "string",
      "title": "Nationality"
    },
    "profile_image_url": {
      "type": "string",
      "title": "Profile Image URL"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Cover Image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "title": "Status",
      "default": "active"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "video_count": {
      "type": "integer",
      "title": "Video Count",
      "default": 0
    },
    "fanclub_enabled": {
      "type": "boolean",
      "title": "Fanclub Enabled",
      "default": false
    },
    "verified": {
      "type": "boolean",
      "title": "Verified",
      "default": false
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "meta_title": {
      "type": "string",
      "title": "Meta Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "v1_id": {
      "type": "string",
      "title": "V1 Migration ID"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending_verification",
        "terminated"
      ],
      "title": "Account Status",
      "default": "active"
    },
    "freeze_reason": {
      "type": "string",
      "title": "Freeze Reason",
      "description": "Reason for account suspension/freeze"
    },
    "outstanding_balance_usd": {
      "type": "number",
      "title": "Outstanding Balance (USD)",
      "default": 0,
      "description": "Amount owed by performer to platform (if any)"
    },
    "revenue_split_pct": {
      "type": "number",
      "title": "Revenue Split (%)",
      "default": 70,
      "description": "Percentage of revenue that goes to the performer"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected",
        "expired"
      ],
      "title": "KYC Status",
      "default": "pending"
    },
    "compliance_locked": {
      "type": "boolean",
      "title": "Compliance Locked",
      "default": false,
      "description": "If true, performer cannot be edited or have content published until unlocked by admin"
    },
    "compliance_override": {
      "type": "boolean",
      "title": "Compliance Override",
      "default": false,
      "description": "If true, admin has manually overridden compliance lock"
    },
    "compliance_override_reason": {
      "type": "string",
      "title": "Compliance Override Reason",
      "description": "Reason for manual compliance override by admin"
    },
    "onlyfans_url": {
      "type": "string",
      "title": "OnlyFans URL"
    },
    "twitter_url": {
      "type": "string",
      "title": "Twitter URL"
    },
    "instagram_url": {
      "type": "string",
      "title": "Instagram URL"
    },
    "production_preferences": {
      "type": "string",
      "title": "Production Preferences",
      "format": "textarea",
      "description": "Notes about performer's production preferences"
    },
    "internal_notes": {
      "type": "string",
      "title": "Internal Notes",
      "format": "textarea",
      "description": "Internal admin notes about this performer"
    },
    "availability_notes": {
      "type": "string",
      "title": "Availability Notes",
      "format": "textarea",
      "description": "Notes about performer's availability for shoots"
    },
    "user_id": {
      "type": "string",
      "title": "Linked User ID",
      "description": "Authenticated user account permanently linked to this performer profile"
    },
    "production_profile_enabled": {
      "type": "boolean",
      "title": "Production Profile Enabled",
      "default": false,
      "description": "Whether performer has an active production compatibility profile"
    },
    "available_production_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Available Production Types",
      "description": "Types of productions performer is available for"
    },
    "preferred_scene_styles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Preferred Scene Styles",
      "description": "Performer's preferred scene styles and aesthetics"
    },
    "available_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Available Roles",
      "description": "Roles performer is available to play"
    },
    "conditional_themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Conditional Themes",
      "description": "Themes that may be possible but require studio review and explicit performer approval"
    },
    "not_available_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Not Available / Boundaries",
      "description": "Hard boundaries - unavailable production elements that must block compatibility matches"
    },
    "privacy_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Privacy Options",
      "description": "Performer's privacy preferences for content distribution"
    },
    "safety_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Safety Requirements",
      "description": "Safety and consent requirements that must be satisfied before approval"
    },
    "production_notes_public": {
      "type": "string",
      "title": "Production Notes (Public)",
      "format": "textarea",
      "description": "Admin-approved notes that may be shown in performer-facing or production-facing contexts"
    },
    "production_notes_internal": {
      "type": "string",
      "title": "Production Notes (Internal)",
      "format": "textarea",
      "description": "Admin-only internal notes - never exposed to performers or public"
    },
    "compatibility_review_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "draft",
        "reviewed",
        "approved",
        "needs_update"
      ],
      "title": "Compatibility Review Status",
      "default": "not_reviewed",
      "description": "Current review status of the production compatibility profile"
    },
    "compatibility_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Compatibility Reviewed At",
      "description": "Timestamp when profile was last reviewed"
    },
    "compatibility_reviewed_by": {
      "type": "string",
      "title": "Compatibility Reviewed By",
      "description": "User ID of admin who last reviewed the profile"
    },
    "last_consent_update_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Consent Update At",
      "description": "Timestamp when consent/boundaries were last updated"
    }
  },
  "required": [
    "display_name",
    "slug"
  ]
}