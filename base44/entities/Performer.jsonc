{
  "name": "Performer",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "bio": {
      "type": "string",
      "title": "Bio",
      "format": "textarea"
    },
    "nationality": {
      "type": "string",
      "title": "Nationality"
    },
    "profile_image_url": {
      "type": "string",
      "title": "Profile Image URL"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Cover Image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "title": "Status",
      "default": "active"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "video_count": {
      "type": "integer",
      "title": "Video Count",
      "default": 0
    },
    "fanclub_enabled": {
      "type": "boolean",
      "title": "Fanclub Enabled",
      "default": false
    },
    "verified": {
      "type": "boolean",
      "title": "Verified",
      "default": false
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "meta_title": {
      "type": "string",
      "title": "Meta Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "v1_id": {
      "type": "string",
      "title": "V1 Migration ID"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending_verification",
        "terminated"
      ],
      "title": "Account Status",
      "default": "active"
    },
    "freeze_reason": {
      "type": "string",
      "title": "Freeze Reason",
      "description": "Reason for account suspension/freeze"
    },
    "outstanding_balance_usd": {
      "type": "number",
      "title": "Outstanding Balance (USD)",
      "default": 0,
      "description": "Amount owed by performer to platform (if any)"
    },
    "revenue_split_pct": {
      "type": "number",
      "title": "Revenue Split (%)",
      "default": 70,
      "description": "Percentage of revenue that goes to the performer"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected",
        "expired"
      ],
      "title": "KYC Status",
      "default": "pending"
    },
    "compliance_locked": {
      "type": "boolean",
      "title": "Compliance Locked",
      "default": false,
      "description": "If true, performer cannot be edited or have content published until unlocked by admin"
    },
    "compliance_override": {
      "type": "boolean",
      "title": "Compliance Override",
      "default": false,
      "description": "If true, admin has manually overridden compliance lock"
    },
    "compliance_override_reason": {
      "type": "string",
      "title": "Compliance Override Reason",
      "description": "Reason for manual compliance override by admin"
    },
    "onlyfans_url": {
      "type": "string",
      "title": "OnlyFans URL"
    },
    "twitter_url": {
      "type": "string",
      "title": "Twitter URL"
    },
    "instagram_url": {
      "type": "string",
      "title": "Instagram URL"
    },
    "production_preferences": {
      "type": "string",
      "title": "Production Preferences",
      "format": "textarea",
      "description": "Notes about performer's production preferences"
    },
    "internal_notes": {
      "type": "string",
      "title": "Internal Notes",
      "format": "textarea",
      "description": "Internal admin notes about this performer"
    },
    "availability_notes": {
      "type": "string",
      "title": "Availability Notes",
      "format": "textarea",
      "description": "Notes about performer's availability for shoots"
    }
  },
  "required": [
    "display_name",
    "slug"
  ]
}