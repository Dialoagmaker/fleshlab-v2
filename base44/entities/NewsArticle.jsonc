{
  "name": "NewsArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "content": {
      "type": "string",
      "title": "Content",
      "format": "textarea"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Cover Image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "title": "Status",
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "title": "Published At"
    },
    "meta_title": {
      "type": "string",
      "title": "Meta Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "v1_id": {
      "type": "string",
      "title": "V1 Migration ID"
    }
  },
  "required": [
    "title",
    "slug"
  ]
}