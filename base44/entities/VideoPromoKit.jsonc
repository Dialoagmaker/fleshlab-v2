{
  "name": "VideoPromoKit",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "title": "Video ID"
    },
    "kit_type": {
      "type": "string",
      "enum": [
        "xhamster",
        "social",
        "full"
      ],
      "title": "Kit Type"
    },
    "xhamster_title": {
      "type": "string",
      "title": "xHamster Title"
    },
    "xhamster_description": {
      "type": "string",
      "title": "xHamster Description",
      "format": "textarea"
    },
    "xhamster_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "xHamster Tags"
    },
    "xhamster_upload_notes": {
      "type": "string",
      "title": "xHamster Upload Notes",
      "format": "textarea"
    },
    "social_short_caption": {
      "type": "string",
      "title": "Short Social Caption",
      "format": "textarea"
    },
    "social_long_caption": {
      "type": "string",
      "title": "Long Social Caption",
      "format": "textarea"
    },
    "twitter_caption": {
      "type": "string",
      "title": "Twitter Caption",
      "format": "textarea"
    },
    "reddit_caption": {
      "type": "string",
      "title": "Reddit Caption",
      "format": "textarea"
    },
    "telegram_caption": {
      "type": "string",
      "title": "Telegram Caption",
      "format": "textarea"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hashtags"
    },
    "cta_text": {
      "type": "string",
      "title": "CTA Text"
    },
    "cover_url": {
      "type": "string",
      "title": "Cover URL"
    },
    "thumbnail_url": {
      "type": "string",
      "title": "Thumbnail URL"
    },
    "preview_url": {
      "type": "string",
      "title": "Preview URL"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Generated At"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By User ID"
    }
  },
  "required": [
    "video_id",
    "kit_type"
  ]
}