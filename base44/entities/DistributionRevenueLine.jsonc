{
  "name": "DistributionRevenueLine",
  "type": "object",
  "properties": {
    "import_id": { "type": "string", "title": "Import ID" },
    "row_hash": { "type": "string", "title": "Stable Source Row Hash" },
    "platform_key": { "type": "string", "title": "Platform Key" },
    "video_id": { "type": "string", "title": "Internal Video ID" },
    "external_content_id": { "type": "string", "title": "External Content ID" },
    "revenue_type": { "type": "string", "enum": ["AD_REVENUE", "PPV", "SUBSCRIPTION", "CLIP_SALES", "OTHER"], "title": "Revenue Type" },
    "currency": { "type": "string", "title": "Currency" },
    "gross_sales": { "type": "number", "title": "Gross Sales" },
    "platform_deductions": { "type": "number", "title": "Platform Deductions" },
    "refunds": { "type": "number", "title": "Refunds" },
    "chargebacks": { "type": "number", "title": "Chargebacks" },
    "net_distribution_revenue": { "type": "number", "title": "Net Distribution Revenue" },
    "views": { "type": "integer", "title": "Views" },
    "qualified_monetized_views": { "type": "integer", "title": "Qualified Monetized Views" },
    "classification": { "type": "string", "enum": ["PLATFORM_REPORTED", "ESTIMATE"], "title": "Data Classification" },
    "period_start": { "type": "string", "format": "date", "title": "Period Start" },
    "period_end": { "type": "string", "format": "date", "title": "Period End" }
  },
  "required": ["import_id", "row_hash", "platform_key", "revenue_type", "currency", "classification", "period_start", "period_end"]
}
