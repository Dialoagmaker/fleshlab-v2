{
  "name": "PayoutRequest",
  "type": "object",
  "properties": {
    "performer_id": {
      "type": "string",
      "title": "Performer ID"
    },
    "requested_by_user_id": {
      "type": "string",
      "title": "Requested By User ID"
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "usd"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "paypal",
        "gcash",
        "paymaya",
        "wise",
        "other"
      ],
      "title": "Payout Method"
    },
    "payout_snapshot_masked": {
      "type": "string",
      "title": "Payout Snapshot (Masked)",
      "description": "Masked payout details at time of request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "paid",
        "cancelled"
      ],
      "title": "Status",
      "default": "pending_review"
    },
    "performer_note": {
      "type": "string",
      "title": "Performer Note",
      "format": "textarea"
    },
    "performer_visible_message": {
      "type": "string",
      "title": "Performer Visible Message",
      "format": "textarea"
    },
    "admin_notes_private": {
      "type": "string",
      "title": "Admin Notes (Private)",
      "format": "textarea"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Requested At"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed At"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "title": "Paid At"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed By User ID"
    },
    "paid_by": {
      "type": "string",
      "title": "Paid By User ID"
    }
  },
  "required": [
    "performer_id",
    "requested_by_user_id",
    "amount",
    "currency",
    "payout_method"
  ]
}