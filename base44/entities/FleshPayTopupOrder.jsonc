{
  "name": "FleshPayTopupOrder",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID",
      "description": "User who initiated the top\u2011up"
    },
    "wallet_id": {
      "type": "string",
      "title": "Wallet ID",
      "description": "Target FleshPayWallet"
    },
    "payment_intent_id": {
      "type": "string",
      "title": "Payment Intent ID",
      "description": "Link to the PaymentIntent record. Also serves as provider_session_id \u2013 PaymentIntent.provider_session_id carries the NOWPayments payment_id."
    },
    "amount_usd": {
      "type": "number",
      "title": "Amount (USD)",
      "description": "Requested top\u2011up amount in USD"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "usd"
    },
    "crypto_currency": {
      "type": "string",
      "title": "Crypto Currency",
      "description": "e.g. BTC, ETH, USDTTRC20"
    },
    "provider": {
      "type": "string",
      "enum": [
        "nowpayments",
        "ccbill",
        "segpay",
        "stripe",
        "paypal",
        "asiapay"
      ],
      "title": "Provider",
      "default": "nowpayments"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "crypto",
        "card",
        "paypal",
        "adult_card_processor",
        "regional_card_processor"
      ],
      "title": "Provider Type",
      "description": "Category of payment provider from the provider registry"
    },
    "provider_payment_id": {
      "type": "string",
      "title": "Provider Payment ID",
      "description": "NOWPayments payment_id"
    },
    "provider_invoice_id": {
      "type": "string",
      "title": "Provider Invoice ID",
      "description": "NOWPayments invoice_id"
    },
    "provider_checkout_url": {
      "type": "string",
      "title": "Provider Checkout URL",
      "description": "NOWPayments hosted checkout page. Alias for checkout_url \u2013 both fields are written in sync."
    },
    "checkout_url": {
      "type": "string",
      "title": "Checkout URL",
      "description": "Primary field \u2013 provider_checkout_url is kept in sync automatically"
    },
    "provider_status": {
      "type": "string",
      "title": "Provider Status",
      "description": "Raw status from the payment provider (e.g. NOWPayments payment_status)"
    },
    "provider_mode": {
      "type": "string",
      "enum": [
        "live",
        "sandbox",
        "test"
      ],
      "title": "Provider Mode",
      "default": "sandbox",
      "description": "Which mode the provider is operating in for this transaction"
    },
    "public_payment_label": {
      "type": "string",
      "title": "Public Payment Label",
      "description": "User-friendly label shown in public UI for this payment method"
    },
    "risk_status": {
      "type": "string",
      "enum": [
        "active",
        "approval_required",
        "future",
        "disabled"
      ],
      "title": "Risk Status",
      "description": "Risk/compliance status of this provider at time of transaction"
    },
    "pay_address": {
      "type": "string",
      "title": "Pay Address",
      "description": "Crypto pay address generated by provider"
    },
    "pay_currency": {
      "type": "string",
      "title": "Pay Currency",
      "description": "Actual crypto currency the user paid in"
    },
    "actually_paid": {
      "type": "number",
      "title": "Actually Paid",
      "description": "Crypto amount actually received by provider"
    },
    "amount_received_usd": {
      "type": "number",
      "title": "Amount Received (USD)",
      "description": "USD equivalent of what was actually received"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirming",
        "paid",
        "expired",
        "failed"
      ],
      "title": "Status",
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At",
      "description": "Timestamp when payment was fully confirmed and wallet was credited. Replaces confirmed_at for consistency with PaymentIntent naming."
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Confirmed At [Legacy]",
      "description": "DEPRECATED \u2013 use completed_at instead. Kept for backwards compat only, written in sync with completed_at."
    },
    "ipn_callback_raw": {
      "type": "string",
      "title": "IPN Callback Raw",
      "format": "textarea",
      "description": "Raw IPN callback data for audit trail"
    },
    "metadata_json": {
      "type": "string",
      "title": "Metadata JSON",
      "description": "Arbitrary JSON payload for provider-specific metadata"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    }
  },
  "required": [
    "user_id",
    "amount_usd"
  ]
}