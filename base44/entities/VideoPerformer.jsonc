{
  "name": "VideoPerformer",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "title": "Video ID"
    },
    "performer_id": {
      "type": "string",
      "title": "Performer ID"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "order": {
      "type": "integer",
      "title": "Display Order",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "title": "Featured Credit",
      "default": false
    },
    "lead_performer": {
      "type": "boolean",
      "title": "Lead Performer",
      "default": false,
      "description": "Primary performer in this video"
    }
  },
  "required": [
    "video_id",
    "performer_id"
  ]
}