      "title": "Video ID"
    },
    "performer_id": {
      "type": "string",
      "title": "Performer ID"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "order": {
      "type": "integer",
      "title": "Display Order",
      "default": 0
    },
    "featured": {
      "type": "boolean",
