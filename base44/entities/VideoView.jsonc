{
  "name": "VideoView",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "title": "Video ID"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "session_id": {
      "type": "string",
      "title": "Session ID"
    },
    "ip_country": {
      "type": "string",
      "title": "IP Country"
    },
    "duration_watched_seconds": {
      "type": "integer",
      "title": "Duration Watched (seconds)"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Viewed At"
    },
    "referrer": {
      "type": "string",
      "title": "Referrer"
    },
    "source": {
      "type": "string",
      "title": "Traffic Source"
    }
  },
  "required": [
    "video_id"
  ]
}