{
  "name": "ComplianceRecord",
  "type": "object",
  "properties": {
    "performer_id": {
      "type": "string",
      "title": "Performer ID"
    },
    "video_id": {
      "type": "string",
      "title": "Video ID"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "id",
        "medical_test",
        "std_test",
        "background_check",
        "work_permit",
        "other"
      ],
      "title": "Document Type"
    },
    "document_url": {
      "type": "string",
      "title": "Document URL (Private R2)"
    },
    "verification_session_id": {
      "type": "string",
      "title": "Identity Verification Session ID"
    },
    "verification_provider": {
      "type": "string",
      "enum": [
        "manual",
        "philsys_national_id_check",
        "veriff",
        "sumsub",
        "onfido",
        "stripe_identity",
        "persona",
        "jumio",
        "idenfy"
      ],
      "title": "Verification Provider",
      "default": "manual"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "manual",
        "philsys_national_id_check",
        "third_party_provider"
      ],
      "title": "Verification Method",
      "default": "manual",
      "description": "Method used for verification"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "passed",
        "failed",
        "needs_review"
      ],
      "title": "Verification Status",
      "default": "not_started"
    },
    "verification_result_summary": {
      "type": "string",
      "title": "Verification Result Summary"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Verified At"
    },
    "verification_checked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Verification Checked At"
    },
    "verification_checked_by": {
      "type": "string",
      "title": "Verification Checked By User ID"
    },
    "verification_note": {
      "type": "string",
      "title": "Verification Note (Internal)",
      "format": "textarea",
      "description": "Internal admin notes about verification"
    },
    "performer_visible_note": {
      "type": "string",
      "title": "Performer Visible Note",
      "format": "textarea",
      "description": "Notes that can be shown to the performer"
    },
    "external_verification_url": {
      "type": "string",
      "title": "External Verification URL",
      "description": "URL of external verification tool (e.g., https://everify.gov.ph/check)"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "title": "Issued At"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "expiring_soon",
        "expired",
        "revoked"
      ],
      "title": "Status",
      "default": "valid"
    },
    "issuing_authority": {
      "type": "string",
      "title": "Issuing Authority"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "v1_id": {
      "type": "string",
      "title": "V1 Migration ID"
    }
  },
  "required": [
    "performer_id",
    "document_type",
    "document_url"
  ]
}