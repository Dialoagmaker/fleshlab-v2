{
  "name": "RecruitmentAuditLog",
  "type": "object",
  "properties": {
    "subject_type": {
      "type": "string",
      "title": "Subject Type"
    },
    "subject_id": {
      "type": "string",
      "title": "Subject ID"
    },
    "action": {
      "type": "string",
      "title": "Action"
    },
    "actor_type": {
      "type": "string",
      "title": "Actor Type"
    },
    "actor_id": {
      "type": "string",
      "title": "Actor ID"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info",
      "title": "Severity"
    },
    "details_json": {
      "type": "string",
      "format": "textarea",
      "title": "Details JSON"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
    }
  },
  "required": [
    "subject_type",
    "action",
    "actor_type",
    "created_at"
  ]
}