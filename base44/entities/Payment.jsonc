{
  "name": "Payment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "amount_usd": {
      "type": "number",
      "title": "Amount (USD)"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "usd"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "subscription",
        "ppv",
        "tip"
      ],
      "title": "Payment Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "title": "Status"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "title": "Stripe Payment Intent ID"
    },
    "stripe_customer_id": {
      "type": "string",
      "title": "Stripe Customer ID"
    },
    "related_entity_type": {
      "type": "string",
      "title": "Related Entity Type"
    },
    "related_entity_id": {
      "type": "string",
      "title": "Related Entity ID"
    },
    "metadata": {
      "type": "string",
      "title": "Metadata (JSON)"
    }
  },
  "required": [
    "user_id",
    "amount_usd",
    "payment_type"
  ]
}