{
  "name": "VideoDeal",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "title": "Video ID"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "sponsorship",
        "product_placement",
        "promotion",
        "affiliate"
      ],
      "title": "Deal Type"
    },
    "brand_name": {
      "type": "string",
      "title": "Brand Name"
    },
    "deal_amount_usd": {
      "type": "number",
      "title": "Deal Amount (USD)"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "usd"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "invoiced",
        "paid",
        "cancelled"
      ],
      "title": "Payment Status",
      "default": "unpaid"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "title": "Paid At"
    },
    "disclosure_required": {
      "type": "boolean",
      "title": "Disclosure Required",
      "default": false
    },
    "disclosure_text": {
      "type": "string",
      "title": "Disclosure Text",
      "format": "textarea",
      "description": "Required disclosure text for this deal"
    },
    "period_month": {
      "type": "string",
      "title": "Period Month",
      "description": "Format: YYYY-MM"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    }
  },
  "required": [
    "video_id",
    "deal_type",
    "brand_name"
  ]
}