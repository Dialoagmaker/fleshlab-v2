{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "manager",
        "viewer",
        "user"
      ]
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "title": "Last Login"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "title": "Last Activity"
    },
    "login_count": {
      "type": "integer",
      "title": "Login Count",
      "default": 0
    },
    "onboarding_completed": {
      "type": "boolean",
      "title": "Onboarding Completed",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}