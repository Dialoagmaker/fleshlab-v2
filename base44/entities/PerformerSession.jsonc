{
  "name": "PerformerSession",
  "type": "object",
  "properties": {
    "performer_id": {
      "type": "string",
      "title": "Performer ID"
    },
    "token": {
      "type": "string",
      "title": "Session Token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
    },
    "revoked": {
      "type": "boolean",
      "title": "Revoked",
      "default": false
    }
  },
  "required": [
    "performer_id",
    "token",
    "expires_at"
  ]
}