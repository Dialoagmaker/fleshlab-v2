{
  "name": "PerformerEarningLineItem",
  "type": "object",
  "properties": {
    "performer_id": {
      "type": "string",
      "title": "Performer ID"
    },
    "performer_earning_id": {
      "type": "string",
      "title": "Performer Earning ID",
      "description": "Optional - link to parent PerformerEarning header record"
    },
    "period_month": {
      "type": "string",
      "title": "Period Month",
      "description": "Format: YYYY-MM"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "video_platform",
        "livecam",
        "fanclub_subscription",
        "ppv_purchase",
        "custom_content",
        "bonus",
        "manual_adjustment",
        "deduction"
      ],
      "title": "Source Type"
    },
    "source_platform": {
      "type": "string",
      "enum": [
        "xhamster",
        "faphouse",
        "chaturbate",
        "stripchat",
        "bongacams",
        "livejasmin",
        "internal",
        "fleshlab",
        "other"
      ],
      "title": "Source Platform"
    },
    "source_reference_id": {
      "type": "string",
      "title": "Source Reference ID",
      "description": "Optional - reference to source record (e.g., VideoStatSnapshot ID, Subscription ID, Payment ID)"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea"
    },
    "gross_amount_usd": {
      "type": "number",
      "title": "Gross Amount (USD)"
    },
    "performer_share_percent": {
      "type": "number",
      "title": "Performer Share (%)",
      "description": "Percentage of gross that goes to performer"
    },
    "performer_amount_usd": {
      "type": "number",
      "title": "Performer Amount (USD)",
      "description": "gross_amount_usd * performer_share_percent / 100"
    },
    "studio_amount_usd": {
      "type": "number",
      "title": "Studio Amount (USD)",
      "description": "gross_amount_usd - performer_amount_usd"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "usd"
    },
    "exchange_rate": {
      "type": "number",
      "title": "Exchange Rate",
      "default": 1,
      "description": "Exchange rate to USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "estimated",
        "pending",
        "approved",
        "paid"
      ],
      "title": "Status",
      "default": "estimated"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "test_mode": {
      "type": "boolean",
      "title": "Test Mode",
      "default": false,
      "description": "If true, this is a test record and should be excluded from payouts"
    }
  },
  "required": [
    "performer_id",
    "period_month",
    "source_type",
    "gross_amount_usd",
    "performer_share_percent",
    "performer_amount_usd",
    "studio_amount_usd",
    "status"
  ]
}