{
  "name": "JobQueue",
  "type": "object",
  "properties": {
    "job_type": {
      "type": "string",
      "enum": [
        "generate_thumbnail",
        "generate_preview",
        "generate_cover",
        "validate_assets",
        "process_video",
        "send_email",
        "compute_stats",
        "generate_sitemap",
        "regenerate_thumbnail",
        "regenerate_preview",
        "regenerate_cover"
      ],
      "title": "Job Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "timeout",
        "callback_received",
        "validating",
        "thumbnail_invalid"
      ],
      "title": "Status",
      "default": "pending"
    },
    "priority": {
      "type": "integer",
      "title": "Priority",
      "default": 5
    },
    "payload": {
      "type": "string",
      "title": "Payload (JSON)"
    },
    "result": {
      "type": "string",
      "title": "Result (JSON)"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "entity_type": {
      "type": "string",
      "title": "Entity Type"
    },
    "entity_id": {
      "type": "string",
      "title": "Entity ID"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "retry_count": {
      "type": "integer",
      "title": "Retry Count",
      "default": 0
    },
    "external_processor_job_id": {
      "type": "string",
      "title": "External Processor Job ID",
      "description": "Job ID returned by external processor for status tracking"
    },
    "external_processor_status": {
      "type": "string",
      "title": "External Processor Status",
      "description": "Last known status from external processor"
    },
    "callback_received_at": {
      "type": "string",
      "format": "date-time",
      "title": "Callback Received At",
      "description": "Timestamp when processor callback was received"
    },
    "callback_attempts": {
      "type": "integer",
      "title": "Callback Attempts",
      "default": 0,
      "description": "Number of callback attempts received"
    },
    "last_callback_payload": {
      "type": "string",
      "title": "Last Callback Payload (JSON)",
      "description": "Raw payload from last callback for debugging"
    },
    "validation_report": {
      "type": "string",
      "title": "Validation Report (JSON)",
      "description": "Detailed validation report from callback"
    }
  },
  "required": [
    "job_type"
  ]
}