{
  "name": "VideoStatSnapshot",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "title": "Video ID",
      "description": "Internal Video ID \u2014 required if source_type = internal"
    },
    "external_video_id": {
      "type": "string",
      "title": "External Video ID",
      "description": "ExternalVideo record ID \u2014 required if source_type = external"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ],
      "title": "Source Type",
      "default": "internal",
      "description": "Whether this stat is for an internal FLESHLAB video or an external platform video"
    },
    "platform": {
      "type": "string",
      "enum": [
        "xhamster",
        "faphouse",
        "internal",
        "boyfriendtv",
        "zapping",
        "pornhub",
        "other"
      ],
      "title": "Platform"
    },
    "period_month": {
      "type": "string",
      "title": "Period Month",
      "description": "Format: YYYY-MM"
    },
    "views": {
      "type": "integer",
      "title": "Views",
      "default": 0
    },
    "likes": {
      "type": "integer",
      "title": "Likes",
      "default": 0
    },
    "favourites": {
      "type": "integer",
      "title": "Favourites",
      "default": 0
    },
    "revenue_usd": {
      "type": "number",
      "title": "Revenue (USD)",
      "default": 0,
      "description": "Gross platform revenue"
    },
    "sales_count": {
      "type": "integer",
      "title": "Sales Count",
      "default": 0
    },
    "tips_usd": {
      "type": "number",
      "title": "Tips (USD)",
      "default": 0
    },
    "promotion_status": {
      "type": "string",
      "enum": [
        "none",
        "planned",
        "active",
        "ended"
      ],
      "title": "Promotion Status",
      "default": "none"
    },
    "promotion_note": {
      "type": "string",
      "title": "Promotion Note",
      "format": "textarea"
    },
    "admin_note": {
      "type": "string",
      "title": "Admin Note",
      "format": "textarea"
    },
    "raw_data_json": {
      "type": "string",
      "title": "Raw Data JSON"
    },
    "import_source": {
      "type": "string",
      "title": "Import Source"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    }
  },
  "required": [
    "platform",
    "period_month"
  ]
}