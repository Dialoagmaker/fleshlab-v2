{
  "name": "Brand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Cover Image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "title": "Status",
      "default": "active"
    },
    "meta_title": {
      "type": "string",
      "title": "Meta Title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta Description"
    },
    "v1_id": {
      "type": "string",
      "title": "V1 Migration ID"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}