{
  "name": "GuestProductionApplication",
  "type": "object",
  "properties": {
    "applicant_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "nationality": {
      "type": "string",
      "title": "Nationality"
    },
    "message": {
      "type": "string",
      "title": "Message",
      "format": "textarea"
    },
    "package_interest": {
      "type": "string",
      "title": "Package Interest"
    },
    "id_document_url": {
      "type": "string",
      "title": "ID Document URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    }
  },
  "required": [
    "applicant_name",
    "email"
  ]
}