{
  "name": "GuestProductionApplication",
  "type": "object",
  "properties": {
    "applicant_name": {
      "type": "string",
      "title": "Stage Name / Name"
    },
    "legal_name": {
      "type": "string",
      "title": "Legal Name (Private)"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone / WhatsApp / Messaging"
    },
    "nationality": {
      "type": "string",
      "title": "Country of Residence"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "experience": {
      "type": "string",
      "title": "Experience",
      "format": "textarea"
    },
    "social_links": {
      "type": "string",
      "title": "Social Links"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Interests"
    },
    "message": {
      "type": "string",
      "title": "Notes / Fantasy Brief",
      "format": "textarea"
    },
    "package_interest": {
      "type": "string",
      "title": "Package Interest"
    },
    "preferred_revenue_model": {
      "type": "string",
      "enum": [
        "standard_studio_60_performer_40",
        "network_performer_70_studio_30",
        "undecided"
      ],
      "title": "Preferred Revenue Model",
      "default": "undecided"
    },
    "profile_photo_r2_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Profile Photo R2 Keys"
    },
    "intro_video_r2_key": {
      "type": "string",
      "title": "Body Video R2 Key"
    },
    "hardcore_video_r2_key": {
      "type": "string",
      "title": "Hardcore Video R2 Key"
    },
    "id_document_r2_key": {
      "type": "string",
      "title": "ID Document R2 Key"
    },
    "id_document_url": {
      "type": "string",
      "title": "ID Document URL (Legacy)"
    },
    "media_upload_status": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "complete"
      ],
      "title": "Media Upload Status",
      "default": "none"
    },
    "compliance_upload_status": {
      "type": "string",
      "enum": [
        "none",
        "uploaded",
        "verified"
      ],
      "title": "ID Upload Status",
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "media_pending",
        "reviewing",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes",
      "format": "textarea"
    },
    "contact_log": {
      "type": "string",
      "title": "Contact Log",
      "format": "textarea"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    },
    "media_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Media Reviewed At"
    },
    "media_reviewed_by": {
      "type": "string",
      "title": "Media Reviewed By (User ID)"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "fan_production",
        "guest_production",
        "performer_application"
      ],
      "title": "Request Type",
      "default": "fan_production",
      "description": "Distinguishes Fan Production requests from other application types"
    },
    "preferred_performer": {
      "type": "string",
      "title": "Preferred Performer"
    },
    "alternate_performer": {
      "type": "string",
      "title": "Alternate Performer (Optional)"
    },
    "open_to_studio_suggestions": {
      "type": "boolean",
      "title": "Open to Studio Suggestions",
      "default": false
    },
    "production_country": {
      "type": "string",
      "title": "Production Country"
    },
    "requested_city": {
      "type": "string",
      "title": "Requested City"
    },
    "is_local_fan": {
      "type": "boolean",
      "title": "Local Fan (already in country)",
      "default": false
    },
    "expected_travel_date": {
      "type": "string",
      "title": "Expected Travel Date / Range"
    },
    "production_package": {
      "type": "string",
      "enum": [
        "short_799",
        "full_1499",
        "premium_2499",
        "custom_quote"
      ],
      "title": "Production Package"
    },
    "production_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Production Preferences"
    },
    "role_dynamic": {
      "type": "string",
      "title": "Role / Dynamic"
    },
    "dominance_preference": {
      "type": "string",
      "title": "Dominance Preference"
    },
    "privacy_option": {
      "type": "string",
      "title": "Privacy / Face Visibility Option"
    },
    "release_preference": {
      "type": "string",
      "title": "Release / Delivery Preference"
    },
    "confirmed_18_plus": {
      "type": "boolean",
      "title": "Confirmed 18+",
      "default": false
    },
    "confirmed_not_private_date": {
      "type": "boolean",
      "title": "Confirmed Not a Private Date",
      "default": false
    },
    "confirmed_performer_approval": {
      "type": "boolean",
      "title": "Confirmed Performer Approval Required",
      "default": false
    },
    "confirmed_preferences_not_guaranteed": {
      "type": "boolean",
      "title": "Confirmed Preferences Not Guaranteed",
      "default": false
    },
    "confirmed_travel_costs": {
      "type": "boolean",
      "title": "Confirmed Own Travel Costs",
      "default": false
    },
    "confirmed_contact_consent": {
      "type": "boolean",
      "title": "Confirmed Contact Consent",
      "default": false
    },
    "applicant_user_id": {
      "type": "string",
      "title": "Applicant User ID",
      "description": "Base44 user ID if logged in at time of submission"
    },
    "source_page": {
      "type": "string",
      "title": "Source Page",
      "description": "Page slug where application was submitted (e.g., gay-performer-recruitment-philippines)"
    },
    "source_country": {
      "type": "string",
      "title": "Source Country",
      "description": "Country/market from application URL (e.g., Philippines)"
    },
    "utm_source": {
      "type": "string",
      "title": "UTM Source",
      "description": "URL param: source (e.g., philippines-recruitment)"
    },
    "utm_market": {
      "type": "string",
      "title": "UTM Market",
      "description": "URL param: market (e.g., philippines)"
    },
    "utm_campaign": {
      "type": "string",
      "title": "UTM Campaign",
      "description": "URL param: campaign (e.g., pinoy_recruitment)"
    }
  },
  "required": [
    "applicant_name",
    "email"
  ]
}