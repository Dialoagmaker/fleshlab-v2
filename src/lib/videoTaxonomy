/**
 * Get all categories flattened
 */
export function getAllCategories() {
  return VIDEO_TAXONOMY.groups.flatMap(g => g.categories);
}

/**
 * Get categories grouped by taxonomy group
 */
export function getGroupedCategories() {
  return VIDEO_TAXONOMY.groups.map(group => ({
    id: group.id,
    label: group.label,
    categories: group.categories.map(cat => ({
      ...cat,
      isApproved: true
    }))
  }));
}

/**
 * Search categories by query
 */
export function searchCategories(query) {
  if (!query || query.trim().length === 0) {
    return [];
  }
  
  const searchQuery = query.toLowerCase().trim();
  const allCats = getAllCategories();
  
  return allCats.filter(cat => {
    const labelMatch = cat.label.toLowerCase().includes(searchQuery);
    const slugMatch = cat.slug.toLowerCase().includes(searchQuery);
    const aliasMatch = cat.aliases.some(alias => alias.toLowerCase().includes(searchQuery));
    
    return labelMatch || slugMatch || aliasMatch;
  });
}

/**
 * Validate video categories
 * - Remove unknown categories unless admin explicitly maps them
 * - Prevent duplicates
 * - Normalize casing
 * - Replace "Teen" display with "Teen (18+)"
 * - Limit categories per video to 3-8
 */
export function validateVideoCategories(categories) {
  if (!Array.isArray(categories)) {
    return { valid: false, errors: ['Categories must be an array'], normalized: [] };
  }
  
  const allCats = getAllCategories();
  const validIds = new Set(allCats.map(c => c.id));
  
  // Normalize and validate
  const normalized = [];
  const errors = [];
  
  for (const cat of categories) {
    // Check if it's a valid ID
    if (validIds.has(cat)) {
      if (!normalized.includes(cat)) {
        normalized.push(cat);
      }
    } else {
      // Try to find by label or alias
      const found = allCats.find(c => 
        c.label.toLowerCase() === cat.toLowerCase() ||
        c.aliases.some(a => a.toLowerCase() === cat.toLowerCase())
      );
      
      if (found) {
        if (!normalized.includes(found.id)) {
          normalized.push(found.id);
        }
      } else {
        errors.push({
          value: cat,
          reason: 'unknown_category',
          message: `Unknown category: ${cat}`
        });
      }
    }
  }
  
  // Check limit
  if (normalized.length > 8) {
    errors.push({
      value: null,
      reason: 'too_many_categories',
      message: `Too many categories (${normalized.length}). Maximum 8 recommended.`
    });
  }
  
  return {
    valid: errors.length === 0,
    errors,
    normalized
  };
}

