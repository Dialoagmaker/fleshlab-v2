# Deployment-only fallback used when the VM already holds the current web image.
# The normal Dockerfile remains the canonical reproducible build.
FROM fleshlab-api AS api
WORKDIR /app
COPY server ./server
COPY migrations ./migrations
CMD ["node", "server/index.js"]

FROM fleshlab-web AS web
COPY portal-static/admin /usr/share/nginx/html/admin
COPY portal-static/performer /usr/share/nginx/html/performer
COPY portal-static/earn /usr/share/nginx/html/earn
COPY portal-static/v3 /usr/share/nginx/html/v3
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
